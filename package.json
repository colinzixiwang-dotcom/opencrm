{
  "name": "harbor-erp",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A local, persistent ERP inspired by the researched Lingxing workflows.",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "10.12.0",
    "playwright": "1.62.1",
    "vite": "^7.1.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "./start.sh",
    "test": "./scripts/go.sh test ./... && node --test tests/frontend.test.mjs && node --test tests/i18n.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run lint && npm run build",
    "test:migration": "node tests/migration.mjs",
    "vet": "./scripts/go.sh vet ./...",
    "lint": "eslint frontend/src",
    "test:rma": "node tests/rma-e2e.mjs",
    "test:browser": "node tests/e2e.mjs && node tests/rma-e2e.mjs && node tests/audit-e2e.mjs && node tests/warranty-e2e.mjs && node tests/i18n-e2e.mjs && node tests/proxy-login-e2e.mjs && node tests/udesk-e2e.mjs && node tests/ticket-presentation-e2e.mjs && node tests/ticket-scope-e2e.mjs",
    "test:proxy": "node tests/proxy-login-e2e.mjs",
    "test:audit": "node tests/audit-e2e.mjs",
    "test:all": "npm run check && npm test && npm run vet && npm run test:browser",
    "test:warranty": "node tests/warranty-e2e.mjs",
    "test:i18n": "node tests/i18n-e2e.mjs",
    "test:udesk": "node tests/udesk-e2e.mjs",
    "test:ticket-presentation": "node tests/ticket-presentation-e2e.mjs",
    "test:ticket-scope": "node tests/ticket-scope-e2e.mjs",
    "test:ticket-filters": "node tests/ticket-column-filters-e2e.mjs",
    "test:catalog": "node tests/catalog-e2e.mjs",
    "test:mabang": "node tests/mabang-e2e.mjs",
    "test:orders": "node tests/order-center-e2e.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.149",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
